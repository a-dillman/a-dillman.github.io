---
const images = [
    "/images/years/2026.png",
    "/images/years/2025.png",
    "/images/years/2024.png",
    "/images/years/2023.png",
    "/images/years/2022.png",
    "/images/years/2021.png",
    "/images/years/2020.png",
    "/images/years/2019.png",
];
---

<section class="marquee-section">

    <!-- RSVP Overlay -->
    <div class="overlay">
        <h2 class="script color-ivory">Click Below!</h2>

        <a href="/Rsvp" class="rsvp-button color-ivory">
            RSVP
        </a>
    </div>

    <!-- Scrolling Photos -->
    <div class="marquee">
        <div class="track">
            {[...images, ...images].map((image) => (
                <img
                    src={image}
                    alt="Audrey and Andrew"
                />
            ))}
        </div>
    </div>

</section>

<style>
.marquee-section {
    position: relative;

    flex: 1;
    min-height: 0;

    width: 100%;

    overflow: hidden;
}

.marquee {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;
}

.track {
    display: flex;
    flex-direction: column;

    width: 100%;

    animation: scroll 140s linear infinite;

    will-change: transform;
}

.track img {
    display: block;

    width: 100vw;
    height: auto;

    flex-shrink: 0;
}

@keyframes scroll {

    from {
        transform: translateY(0);
    }

    to {
        transform: translateY(-50%);
    }

}

.overlay {
    position: absolute;

    inset: 0;

    display: flex;
    flex-direction: column;

    justify-content: center;
    align-items: center;

    gap: 1.5rem;

    z-index: 10;

    background: rgba(0, 0, 0, .28);

    text-align: center;

    pointer-events: none;
}

.overlay h2 {
    margin: 0;

    font-size: clamp(3.5rem, 10vw, 7rem);

    text-shadow: 0 2px 10px rgba(0, 0, 0, .45);
}

.rsvp-button {
    font-family: "PT Serif", serif;

    font-size: clamp(1.2rem, 2.5vw, 1.5rem);

    text-decoration: none;

    background: rgb(218, 133, 129);

    padding: 1.1rem 3rem;

    border-radius: 999px;

    transition: .25s;

    pointer-events: auto;
}

.rsvp-button:hover {
    transform: translateY(-2px);

    background: rgb(209, 106, 106);
}

@media (max-width: 768px) {

    .overlay {
        gap: 1rem;
    }

    .overlay h2 {
        font-size: clamp(3rem, 13vw, 5rem);
    }

}
</style>
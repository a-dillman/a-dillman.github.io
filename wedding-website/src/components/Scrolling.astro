---
const images = [
    "/images/years/2026.png",
    "/images/years/2025.png",
    "/images/years/2024.png",
    "/images/years/2023.png",
    "/images/years/2022.png",
    "/images/years/2021.png",
    "/images/years/2020.png",
    "/images/years/2019.png",
];
---

<section class="marquee-section">

    <div class="overlay">
        <h2 class="script color-ivory">Click Below!</h2>

        <a href="/rsvp" class="rsvp-button color-ivory">
            RSVP
        </a>
    </div>

    <div class="marquee">
        <div class="track">
            {[...images, ...images].map((image) => (
                <img src={image} alt="Audrey and Andrew" />
            ))}
        </div>
    </div>

</section>

<script>
    function startMarquee() {
        const track = document.querySelector(".track");

        if (!track) return;

        track.style.animation = "none";

        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                track.style.animation = "";
            });
        });
    }

    if (document.readyState === "complete") {
        startMarquee();
    } else {
        window.addEventListener("load", startMarquee);
    }

    document.addEventListener("astro:page-load", startMarquee);
</script>

<style>
.marquee-section {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
}

.marquee {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.track {
    display: flex;
    flex-direction: column;

    width: 100%;
    height: max-content;

    animation: scroll 140s linear infinite;
    will-change: transform;
}

.track img {
    display: block;

    width: 100vw;
    height: auto;

    flex-shrink: 0;
}

@keyframes scroll {
    from {
        transform: translateY(0);
    }

    to {
        transform: translateY(-50%);
    }
}

.overlay {
    position: absolute;
    inset: 0;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    gap: 1.5rem;

    z-index: 2;

    background: rgba(0, 0, 0, .28);

    text-align: center;
}

.overlay h2 {
    margin: 0;
    font-size: clamp(3.5rem, 10vw, 7rem);
}

.rsvp-button {
    font-family: "PT Serif", serif;
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);

    text-decoration: none;

    background: rgb(218, 133, 129);

    padding: 1.1rem 3rem;

    border-radius: 999px;

    transition: .25s;
}

.rsvp-button:hover {
    transform: translateY(-2px);
    background: rgb(209, 106, 106);
}

@media (max-width: 768px) {
    .track img {
        width: 100vw;
    }

    .overlay {
        gap: 1rem;
    }
}
</style>
---
const images = [
    "/images/engagement-photos/IMG_1988.jpg",
    "/images/engagement-photos/IMG_1989.jpg",
    "/images/engagement-photos/IMG_1992.jpg",
    "/images/engagement-photos/IMG_2018.jpg",
    "/images/engagement-photos/IMG_2015.jpg",
    "/images/engagement-photos/IMG_2016.jpg",
    "/images/engagement-photos/IMG_1996.jpg",
    "/images/engagement-photos/IMG_1999.jpg",
    "/images/engagement-photos/IMG_2009.jpg",
    "/images/engagement-photos/IMG_2014.jpg",
];
---

<div class="frame">

    <img
        class="doily"
        src="/images/doily.png"
        alt=""
        aria-hidden="true"
    />

    <div class="photo-frame">

        <img
            id="carousel-image-1"
            class="carousel-image active"
            src={images[0]}
            alt="Audrey and Andrew"
        />

        <img
            id="carousel-image-2"
            class="carousel-image"
            src={images[1]}
            alt=""
            aria-hidden="true"
        />

    </div>

</div>

<script define:vars={{ images }}>
    let current = 0;
    let active = 1;

    const image1 = document.getElementById("carousel-image-1");
    const image2 = document.getElementById("carousel-image-2");

    setInterval(() => {
        current = (current + 1) % images.length;

        if (active === 1) {
            image2.src = images[current];
            image2.classList.add("active");
            image1.classList.remove("active");
            active = 2;
        } else {
            image1.src = images[current];
            image1.classList.add("active");
            image2.classList.remove("active");
            active = 1;
        }
    }, 3000);
</script>

<style>
.frame {
    position: relative;

    width: min(700px, 95vw);
    aspect-ratio: 1.65;

    display: flex;
    justify-content: center;
    align-items: center;

    margin: 2rem auto;
}

.doily {
    position: absolute;

    width: 100%;
    height: 100%;

    object-fit: contain;

    z-index: 0;

    pointer-events: none;
}

.photo-frame {
    position: relative;

    width: 82%;
    height: 85%;

    overflow: hidden;

    border-radius: 50%;

    z-index: 1;
}

.carousel-image {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    opacity: 0;

    transition: opacity 2s ease-in-out;
}

.carousel-image.active {
    opacity: 1;
}
</style>